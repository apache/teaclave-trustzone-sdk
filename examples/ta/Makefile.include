# TARGET is the OP-TEE rust.mk / `source environment` interface.
# cargo-optee --arch / --std are derived from that triple.
TARGET ?= $(or $(TARGET_TA),aarch64-unknown-linux-gnu)
ifneq ($(filter arm-unknown-%,$(TARGET)),)
OPTEE_ARCH := --arch arm
else
OPTEE_ARCH := --arch aarch64
endif
ifneq ($(STD),)
OPTEE_STD := --std
else ifneq ($(filter %-unknown-optee,$(TARGET)),)
OPTEE_STD := --std
else
OPTEE_STD := --no-std
endif
ifneq ($(CROSS_COMPILE_TA),)
CROSS_COMPILE := $(CROSS_COMPILE_TA)
endif
ifneq ($(CROSS_COMPILE),)
export CROSS_COMPILE
endif
ifneq ($(TA_SIGN_KEY),)
OPTEE_SIGNING_KEY := --signing-key "$(TA_SIGN_KEY)"
endif

SDK_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
CARGO_OPTEE ?= cargo run --manifest-path $(SDK_ROOT)/tools/Cargo.toml -q -p cargo-optee --
INSTALL_DIR ?= $(CURDIR)/shared

.PHONY: all clippy ta strip sign install emulate clean

ifeq ($(GROUP),y)

all clippy ta install clean:
	@set -e; for member in $(MEMBERS); do \
		$(MAKE) -C $$member $@ TARGET=$(TARGET) \
			INSTALL_DIR="$(abspath $(INSTALL_DIR))" \
			$(if $(STD),STD="$(STD)") \
			$(if $(CROSS_COMPILE),CROSS_COMPILE=$(CROSS_COMPILE)) \
			$(if $(TA_SIGN_KEY),TA_SIGN_KEY="$(TA_SIGN_KEY)"); \
	done

else

all: ta

clippy:
	@$(CARGO_OPTEE) clippy ta $(OPTEE_ARCH) $(OPTEE_STD)

ta: clippy
	@$(CARGO_OPTEE) build ta $(OPTEE_ARCH) $(OPTEE_STD) $(OPTEE_SIGNING_KEY)

install: clippy
	@mkdir -p "$(INSTALL_DIR)"
	@$(CARGO_OPTEE) install ta $(OPTEE_ARCH) $(OPTEE_STD) $(OPTEE_SIGNING_KEY) --target-dir "$(INSTALL_DIR)"

clean:
	@cargo clean

endif

# Compatibility aliases: cargo-optee owns stripping and signing.
strip sign: ta

ifeq ($(EMULATE),y)
emulate: INSTALL_DIR = $(if $(QEMU_HOST_SHARE_DIR),$(QEMU_HOST_SHARE_DIR)/ta,$(error QEMU_HOST_SHARE_DIR must be set))
emulate: install
endif
